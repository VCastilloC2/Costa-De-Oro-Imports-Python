DB_USERNAME=
DB_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REMEMBER_ME_KEY=
REMEMBER_ME_TOKEN=604800
PASSWORD_URL_RECAPTCHA=https://www.google.com/recaptcha/api/siteverify
PASSWORD_KEY_RECAPTCHA=
MAIL_USERNAME=
MAIL_PASSWORD=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
GEMINI_API_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
PORT=8080
NombreAplicacion=Costa De Oro Imports API
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
GOOGLE_ALLOWED_CLIENT_IDS=
JWT_SECRET_ECOMMERCE=REEMPLAZAR_CON_SECRETO_ALEATORIO_LARGO
JWT_ISSUER_ECOMMERCE=CostaDeOroImports
VALKEY_URL=
VALKEY_CACHE_TTL_SECONDS=300
VALKEY_AUTH_TTL_SECONDS=300
PREDICTION_DATA_SOURCE=database
PREDICTION_DATASET_CSV=app/prediction/data/costa_de_oro_ventas.csv
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_ALLOWED_CLIENT_IDS=
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
MCP_CLIENT_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
# --- Servicio ML de predicciones (TensorFlow) ---
# Directorio de modelos entrenados (en serverless usa una ruta escribible y persistente)
PREDICTION_MODEL_DIR=app/prediction/artifacts
PREDICTION_MIN_TRAINING_SAMPLES=18
PREDICTION_MAX_CONCURRENT=4
PREDICTION_INFERENCE_TIMEOUT_SECONDS=30
PREDICTION_DEDUP_WINDOW_SECONDS=300
PREDICTION_TRAINING_LOCK_TTL_SECONDS=3600
# Roles JWT autorizados a consultar/generar predicciones (entrenar exige siempre ADMIN)
PREDICTION_ALLOWED_ROLES=ADMIN
PREDICTION_ACCESS_LOG_ENABLED=true
# --- Passkeys (WebAuthn) ---
# Dominio (sin esquema ni puerto). Vacío = passkeys desactivadas. Debe coincidir con PASSKEY_RP_ID de Flutter.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Costa de Oro Imports
# Orígenes separados por coma: https://<dominio> (iOS) y android:apk-key-hash:<sha256 base64url> (Android)
PASSKEY_EXPECTED_ORIGINS=
PASSKEY_CHALLENGE_TTL_SECONDS=300
PASSKEY_CACHE_TTL_SECONDS=3600
PASSKEY_SESSION_TTL_SECONDS=3600
PASSKEY_CEREMONY_TIMEOUT_MS=120000
# --- Gemini: límites y asistentes ---
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=800
CHATBOT_CONTEXT_CACHE_SECONDS=60
CHATBOT_RATE_LIMIT_PER_MINUTE=20
SHOP_ASSISTANT_ENABLED=true
SHOP_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
SHOP_ASSISTANT_DAILY_LIMIT=2000
SHOP_ASSISTANT_MAX_OUTPUT_TOKENS=500
